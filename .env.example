# Server Configuration
PORT=4000
NODE_ENV=development
# Payment mode: 'testnet' (Base Sepolia real settlement) or 'mock' (local simulated demo)
# NOTE: Server refuses to start if NODE_ENV=production and PAYMENT_MODE=mock
PAYMENT_MODE=mock

# x402 EVM Configuration
# Recipient address to receive payments (EVM hex address)
PAYMENT_RECIPIENT_ADDRESS=0x000000000000000000000000000000000000dEaD
# Facilitator URL (default official testnet facilitator: https://x402.org/facilitator)
X402_FACILITATOR_URL=https://x402.org/facilitator
# EVM Network CAIP-2 identifier: Base Sepolia is eip155:84532
X402_NETWORK=eip155:84532
# Asset token address (Base Sepolia USDC or native)
X402_ASSET_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Pricing in USD / human-readable string format (parsed by x402 scheme)
PRICE_CITY_BIOSCOPE=$0.001
PRICE_EXPLAIN_BIOSCOPE=$0.002
PRICE_DEVELOPER_BIOSCOPE=$0.001

# CORS Allowed Origins (comma-separated or single)
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Optional AI Provider (if empty, deterministic high-quality responses labelled 'DEMO IMPLEMENTATION' are returned)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=10000

# Client Configuration (used by Vite)
VITE_API_URL=http://localhost:4000

# CLI Pay-Client Testnet configuration (DO NOT paste real private keys into public repos)
# TESTNET_PRIVATE_KEY=0x...
